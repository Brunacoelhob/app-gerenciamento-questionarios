{
  "name": "sistema-questionarios",
  "version": "1.1.0",
  "private": true,
  "description": "Gestão e aplicação de questionários (front-end JS + json-server)",
  "license": "MIT",
  "scripts": {
    "preparar-db": "node scripts/preparar-db.js",
    "api": "json-server --watch db.json --port 3000",
    "web": "http-server . -p 8080 -c-1 --silent",
    "start": "npm run preparar-db && concurrently -k -n api,web \"npm:api\" \"npm:web\"",
    "test": "node --test \"test/**/*.test.js\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "http-server": "^14.1.1",
    "json-server": "^0.17.4"
  }
}
